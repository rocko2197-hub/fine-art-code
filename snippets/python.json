{
  "Async Function Block with Telemetry": {
    "prefix": "fa-async",
    "description": "Async function with perf timing, structured logging, and isolated error boundaries.",
    "body": [
      "import logging",
      "import time",
      "",
      "logger = logging.getLogger(__name__)",
      "",
      "",
      "async def ${1:function_name}(${2:context}) -> ${3:None}:",
      "\t\"\"\"${4:Executable logic unit with isolated catch boundaries.}\"\"\"",
      "\tstart = time.perf_counter()",
      "\ttry:",
      "\t\tlogger.info('[%s] Execution initiated.', '${1:function_name}')",
      "\t\t$0",
      "\t\tduration_ms = (time.perf_counter() - start) * 1000",
      "\t\tlogger.info('[%s] Execution succeeded in %.2fms.', '${1:function_name}', duration_ms)",
      "\texcept Exception as error:",
      "\t\tduration_ms = (time.perf_counter() - start) * 1000",
      "\t\tlogger.exception('[%s] Critical failure after %.2fms.', '${1:function_name}', duration_ms)",
      "\t\t# TODO: Implement telemetry / crash reporting connection here",
      "\t\traise"
    ]
  },

  "Production Pydantic Schema": {
