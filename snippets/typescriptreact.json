  "Resilient Custom Fetch Hook": {
    "prefix": "fah-hook",
    "description": "Generates a robust, type-safe custom React hook for data fetching, equipped with loading states, error boundaries, and network request cancellation via AbortController.",
    "body": [
      "import { useState, useEffect } from 'react';",
      "",
      "interface HookResponse<T> {",
      "\tdata: T | null;",
      "\tisLoading: boolean;",
      "\terror: string | null;",
      "}",
      "",
      "export const useStatefulFetch = <T,>(url: string): HookResponse<T> => {",
      "\tconst [data, setData] = useState<T | null>(null);",
      "\tconst [isLoading, setIsLoading] = useState<boolean>(true);",
      "\tconst [error, setError] = useState<string | null>(null);",
      "",
      "\tuseEffect(() => {",
      "\t\tconst controller = new AbortController();",
      "\t\tconst execFetch = async () => {",
      "\t\t\ttry {",
      "\t\t\t\tsetIsLoading(true);",
      "\t\t\t\tconst res = await fetch(url, { signal: controller.signal });",
      "\t\t\t\tif (!res.ok) throw new Error(`Network unexpected status: ${res.status}`);",
      "\t\t\t\tconst json = await res.json();",
      "\t\t\t\tsetData(json);",
      "\t\t\t} catch (err: any) {",
      "\t\t\t\tif (err.name !== 'AbortError') {",
      "\t\t\t\t\tsetError(err.message || 'An unexpected error occurred');",
      "\t\t\t\t}",
      "\t\t\t} finally {",
      "\t\t\t\tsetIsLoading(false);",
      "\t\t\t}",
      "\t\t};",
      "",
      "\t\texecFetch();",
      "\t\treturn () => controller.abort();",
      "\t}, [url]);",
      "",
      "\treturn { data, isLoading, error };",
      "};",
      "$0"
    ]
  },

