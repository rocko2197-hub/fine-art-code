  "Production React Context Architecture": {
    "prefix": "fac-ctx",
    "description": "Scaffolds a high-performance, type-safe React Context split-provider pattern using useReducer and useMemo to prevent unnecessary re-renders.",
    "body": [
      "import React, { createContext, useContext, useReducer, useMemo } from 'react';",
      "",
      "interface StateType {",
      "\tdata: any[];",
      "\tisLoading: boolean;",
      "\terror: string | null;",
      "}",
      "",
      "type ActionType =",
      "\t| { type: 'FETCH_START' }",
      "\t| { type: 'FETCH_SUCCESS'; payload: any[] }",
      "\t| { type: 'FETCH_FAILURE'; payload: string };",
      "",
      "const initialState: StateType = { data: [], isLoading: false, error: null };",
      "",
      "const reducer = (state: StateType, action: ActionType): StateType => {",
      "\tswitch (action.type) {",
      "\t\tcase 'FETCH_START': return { ...state, isLoading: true, error: null };",
      "\t\tcase 'FETCH_SUCCESS': return { ...state, isLoading: false, data: action.payload };",
      "\t\tcase 'FETCH_FAILURE': return { ...state, isLoading: false, error: action.payload };",
      "\t\tdefault: return state;",
      "\t}",
      "};",
      "",
      "const ${1:Name}StateContext = createContext<StateType | undefined>(undefined);",
      "const ${1:Name}DispatchContext = createContext<React.Dispatch<ActionType> | undefined>(undefined);",
      "",
      "export const ${1:Name}Provider: React.FC<{ children: React.ReactNode }> = ({ children }) => {",
      "\tconst [state, dispatch] = useReducer(reducer, initialState);",
      "\tconst memoizedState = useMemo(() => state, [state]);",
      "",
      "\treturn (",
      "\t\t<${1:Name}StateContext.Provider value={memoizedState}>",
      "\t\t\t<${1:Name}DispatchContext.Provider value={dispatch}>",
      "\t\t\t\t{children}",
      "\t\t\t</${1:Name}DispatchContext.Provider>",
      "\t\t</${1:Name}StateContext.Provider>",
      "\t);",
      "};",
      "",
      "export const use${1:Name}State = () => {",
      "\tconst context = useContext(${1:Name}StateContext);",
      "\tif (context === undefined) throw new Error('use${1:Name}State must be used within a ${1:Name}Provider');",
      "\treturn context;",
      "};",
      "",
      "export const use${1:Name}Dispatch = () => {",
      "\tconst context = useContext(${1:Name}DispatchContext);",
      "\tif (context === undefined) throw new Error('use${1:Name}Dispatch must be used within a ${1:Name}Provider');",
      "\treturn context;",
      "};",
      "$0"
    ]
  },

