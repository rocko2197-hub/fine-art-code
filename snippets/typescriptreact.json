      "\t\theaders: {",
      "\t\t\t'Content-Type': 'application/json',",
      "\t\t\t'Accept': 'application/json'",
      "\t\t}",
      "\t});",
      "",
      "\tif (!response.ok) {",
      "\t\tthrow new Error(`HTTP Transport Exception: Status ${response.status} explicitly returned by remote infrastructure.`);",
      "\t}",
      "",
      "\tconst data = await response.json();",
      "\treturn data;",
      "};"
    ]
