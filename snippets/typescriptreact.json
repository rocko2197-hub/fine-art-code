  "Async Function Block with Telemetry": {
    "prefix": "fa-async",
    "description": "Scaffolds a robust async arrow function wrapper complete with explicit try/catch blocks and high-precision performance tracking telemetry.",
    "body": [
      "/**",
      " * ${1:functionName} - Executable logic unit with isolated catch boundaries.",
      " * @param {Object} context - Execution payload",
      " */",
      "const ${1:functionName} = async (${2:context}) => {",
      "\tconst startTime = performance.now();",
      "\ttry {",
      "\t\tconsole.log(`[${1:functionName}] Execution initiated.`);",
      "\t\t$0",
      "\t\tconst duration = (performance.now() - startTime).toFixed(2);",
      "\t\tconsole.log(`[${1:functionName}] Execution succeeded in ${duration}ms.`);",
      "\t} catch (error) {",
      "\t\tconst duration = (performance.now() - startTime).toFixed(2);",
      "\t\tconsole.error(`[${1:functionName}] Critical failure after ${duration}ms:`, error.message);",
      "\t\t// TODO: Implement telemetry / crash reporting connection here",
      "\t\tthrow error;",
      "\t}",
      "};"
    ]
  },

