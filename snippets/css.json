{
  "Production Flex Center Layout": {
    "prefix": "fa-flex-center",
    "description": "Flexbox centering with gap, wrap, and min-height container guard.",
    "body": [
      "display: flex;",
      "flex-wrap: wrap;",
      "align-items: center;",
      "justify-content: center;",
      "gap: ${1:1rem};",
      "min-height: ${2:100%};",
      "$0"
    ]
  },

  "Fluid Responsive CSS Grid Engine": {
    "prefix": "fa-css-grid",
    "description": "Generates a completely fluid, responsive CSS Grid wrapper layout using auto-fit and dynamic calc math to remove manual media-query friction.",
    "body": [
      "/* Fluid Enterprise Grid Architecture */",
      ".${1:grid-container} {",
      "\tdisplay: grid;",
      "\t/* Automatically wraps rows based on content boundaries without breaking layout grids */",
      "\tgrid-template-columns: repeat(auto-fit, minmax(calc(${2:250px} + 1rem), 1fr));",
      "\tgap: ${3:1.5rem};",
      "\talign-content: start;",
      "\tjustify-items: stretch;",
      "\tpadding: ${4:1rem};",
      "\tmargin: 0 auto;",
      "\tmax-width: ${5:1200px};",
      "}"
    ]
  },

  "Responsive Grid Engine": {
    "prefix": "fa-grid",
    "description": "Production CSS Grid with auto-fit tracks, fluid gaps, and alignment controls.",
    "body": [
      "display: grid;",
      "grid-template-columns: repeat(auto-fit, minmax(min(${1:16rem}, 100%), 1fr));",
      "gap: clamp(${2:0.75rem}, ${3:2vw}, ${4:1.5rem});",
      "align-items: ${5|start,center,stretch|};",
      "justify-items: ${6|stretch,center,start|};",
      "$0"
    ]
  },

  "Fluid Clamp Typography": {
    "prefix": "fa-clamp",
    "description": "Fluid font-size with clamp() and line-height pairing",
    "body": [
      "font-size: clamp(${1:1rem}, ${2:1rem} + ${3:1.5vw}, ${4:1.5rem});",
      "line-height: ${5:1.5};"
    ]
  },

  "Accessible Focus Ring": {
    "prefix": "fa-focus",
    "description": "Accessible focus-visible ring using theme tokens",
    "body": [
      "&:focus-visible {",
      "\toutline: 2px solid var(--fa-burnt-umber, ${1:currentColor});",
      "\toutline-offset: 2px;",
      "}"
    ]
  },

  "Visually Hidden Utility": {
    "prefix": "fa-sr-only",
    "description": "Screen-reader-only utility",
    "body": [
      "position: absolute;",
      "width: 1px;",
      "height: 1px;",
      "padding: 0;",
      "margin: -1px;",
      "overflow: hidden;",
      "clip: rect(0, 0, 0, 0);",
      "white-space: nowrap;",
      "border: 0;"
    ]
  },

  "Fine Art Design Token Block": {
    "prefix": "fa-cssvar",
    "description": "Full Fine Art Code Umber design tokens — color, spacing, radius, motion.",
    "body": [
      ":root {",
      "\t/* Fine Art Code – Umber design tokens */",
      "",
      "\t/* Color — ground */",
      "\t--fa-bg-deep: #2a1510;",
      "\t--fa-bg-editor: #2e2720;",
      "\t--fa-bg-sidebar: #3a2f26;",
      "\t--fa-bg-hover: #3d3028;",
      "\t--fa-border: #52443a;",
      "",
      "\t/* Color — text */",
      "\t--fa-text: #e8ddd0;",
      "\t--fa-text-secondary: #c4b49e;",
      "\t--fa-text-muted: #8a7668;",
      "",
      "\t/* Color — syntax roles */",
      "\t--fa-burnt-umber: #8a3324;",
      "\t--fa-burnt-umber-light: #a85a44;",
      "\t--fa-celadon: #6fa58a;",
      "\t--fa-verdigris: #4d8a6e;",
      "\t--fa-naples-yellow: #d4a84b;",
      "\t--fa-yellow-ochre: #e8c87a;",
      "\t--fa-cerulean: #7aafc4;",
      "\t--fa-success: #8fbe6e;",
      "",
      "\t/* Spacing scale */",
      "\t--fa-space-xs: 0.25rem;",
      "\t--fa-space-sm: 0.5rem;",
      "\t--fa-space-md: 1rem;",
      "\t--fa-space-lg: 1.5rem;",
      "\t--fa-space-xl: 2rem;",
      "",
      "\t/* Radius + motion */",
      "\t--fa-radius-sm: 0.25rem;",
      "\t--fa-radius-md: 0.5rem;",
      "\t--fa-radius-lg: 1rem;",
      "\t--fa-transition: 180ms cubic-bezier(0.4, 0, 0.2, 1);",
      "\t$0",
      "}"
    ]
  },

  "Custom Property Block": {
    "prefix": "fa-vars",
    "description": ":root custom properties block",
    "body": [
      ":root {",
      "\t--${1:name}: ${2:value};",
      "\t$0",
      "}"
    ]
  },

  "Container Query Layout": {
    "prefix": "fa-container",
    "description": "Container query wrapper with named containment context.",
    "body": [
      ".${1:container} {",
      "\tcontainer-type: inline-size;",
      "\tcontainer-name: ${1:container};",
      "}",
      "",
      "@container ${1:container} (min-width: ${2:40rem}) {",
      "\t.${3:target} {",
      "\t\t$0",
      "\t}",
      "}"
    ]
  },

  "Media Query": {
    "prefix": "fa-mq",
    "description": "min-width media query",
    "body": [
      "@media (min-width: ${1:48rem}) {",
      "\t$0",
      "}"
    ]
  },

  "Motion Transition Block": {
    "prefix": "fa-transition",
    "description": "Motion-safe transition with reduced-motion fallback.",
    "body": [
      "transition: ${1|color,opacity,transform,all|} ${2:0.2s} ${3|cubic-bezier(0.4, 0, 0.2, 1),ease,ease-in-out|};",
      "",
      "@media (prefers-reduced-motion: reduce) {",
      "\ttransition: none;",
      "}"
    ]
  }
}
